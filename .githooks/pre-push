#!/bin/sh
if [ -n "$RAG_PYTHON" ]; then
  PY="$RAG_PYTHON"
elif command -v python >/dev/null 2>&1; then
  PY="python"
elif command -v python3 >/dev/null 2>&1; then
  PY="python3"
else
  echo "python not found" >&2
  exit 1
fi
"$PY" verify.py || exit 1

# Extra wording check when pushing to the public remote
if [ "$1" = "public" ] || echo "$2" | grep -q "shenzhen-dongguan-policy-rag\.git$"; then
  "$PY" scripts/check_public_wording.py || exit 1
fi
