# DeepSeek（查询分析与生成）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
RAG_LLM_MODEL=deepseek-flash

# 索引 / 模型目录：必须是纯 ASCII 路径
# Windows 示例：F:/refrag-data
# Linux/macOS 示例：/data/refrag
REFRAG_DATA_DIR=<your-ascii-dir>
RAG_INDEX_DIR=<your-ascii-dir>/index
RAG_RERANK_MODEL=<your-ascii-dir>/models/bge-reranker-base

# 可选：模型缓存
HF_HOME=<your-cache-dir>
