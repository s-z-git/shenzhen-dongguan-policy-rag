# DeepSeek（查询分析与生成）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
RAG_LLM_MODEL=deepseek-flash

# 索引 / 模型目录：建议放纯 ASCII 路径；Linux/macOS 改成 /data/refrag 一类
REFRAG_DATA_DIR=F:\refrag-data
RAG_INDEX_DIR=F:\refrag-data\index
RAG_RERANK_MODEL=F:\refrag-data\models\bge-reranker-base

# 可选：模型缓存
HF_HOME=F:\HF-Cache
