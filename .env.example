# DeepSeek（查询分析与生成）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
RAG_LLM_MODEL=deepseek-flash

# 下面是 Windows 示例；公开复现请改成你的纯 ASCII 目录
REFRAG_DATA_DIR=F:\refrag-data
RAG_INDEX_DIR=F:\refrag-data\index
RAG_RERANK_MODEL=F:\refrag-data\models\bge-reranker-base

# 可选：模型缓存
HF_HOME=F:\HF-Cache
